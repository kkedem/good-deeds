# Copy to .env.local for local development. On Vercel, set these under
# Project Settings > Environment Variables, then redeploy: NEXT_PUBLIC_* values
# are baked in at build time.

# --- Google Maps -------------------------------------------------------------
# Browser key for the Maps JavaScript API. Leave empty to use the built-in
# Leaflet/OpenStreetMap map instead.
# In Google Cloud Console:
#   - Enable the "Maps JavaScript API" (billing must be enabled on the project).
#   - Restrict this key: Application restrictions > Websites (HTTP referrers):
#       http://localhost:3000/*
#       https://good-deeds-sooty.vercel.app/*
#     API restrictions > Restrict key > Maps JavaScript API only.
#   This key is public (it ships to the browser), so the referrer restriction is
#   what stops other sites from using it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional map ID (Google Cloud Console > Map Management) for cloud-based map
# styling. Advanced (HTML) markers need a map ID; defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
